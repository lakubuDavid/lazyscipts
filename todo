#!/usr/bin/env lua
-- todo.lua — a tiny markdown-backed todo CLI, meant to be hackable and LLM-friendly.
--
-- Usage:
--   todo add TITLE "DESCRIPTION" ["DETAILS"]
--   todo list|ls [--all|--done|--pending|--canceled|--in-progress|--status=STATUS]
--   todo status TASK_ID
--   todo update TASK_ID pending|in-progress|done|canceled
--   todo edit TASK_ID            (interactive $EDITOR; NOT for AI agents, no TTY)
--   todo init [--embed] [--agents|--no-agents]
--
-- Storage:
--   ./todos/index.lua        -- a Lua table (not JSON), loaded with dofile()
--   ./todos/NNN-slug.md       -- one markdown file per task, real YAML frontmatter

local TODO_DIR = "todos"
local INDEX_FILE = TODO_DIR .. "/index.lua"

-- ---------- small utils ----------

local function ensure_dir(path)
  os.execute('mkdir -p "' .. path .. '"')
end

local function read_file(path)
  local f = io.open(path, "r")
  if not f then return nil end
  local content = f:read("*a")
  f:close()
  return content
end

local function write_file(path, content)
  local f = assert(io.open(path, "w"), "could not open " .. path .. " for writing")
  f:write(content)
  f:close()
end

local function pad_id(n)
  return string.format("%03d", n)
end

local function slugify(title)
  local s = title:lower()
  s = s:gsub("[^%w%s-]", "")   -- strip punctuation
  s = s:gsub("%s+", "-")       -- spaces -> dashes
  s = s:gsub("%-+", "-")       -- collapse dashes
  s = s:gsub("^%-+", ""):gsub("%-+$", "")
  return s
end

local function iso_now()
  return os.date("!%Y-%m-%dT%H:%M:%S")
end

local function escape_lua_string(s)
  s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n")
  return s
end

local function set_frontmatter_field(path, field, value)
  local content = read_file(path)
  if not content then return false end
  local pattern = "(" .. field .. ":%s*)[^\n]*"
  local updated, n = content:gsub(pattern, "%1" .. value:gsub("%%", "%%%%"), 1)
  if n == 0 then return false end
  write_file(path, updated)
  return true
end

local function get_frontmatter_field(path, field)
  local content = read_file(path)
  if not content then return nil end
  return content:match(field .. ':%s*"?([^"\n]*)"?')
end

-- ---------- statuses ----------

local STATUSES = { pending = true, ["in-progress"] = true, done = true, canceled = true }

-- ---------- tty / prompt ----------

local function is_tty()
  local ok, _, code = os.execute("test -t 0 2>/dev/null")
  return ok == true or ok == 0
end

local function prompt_yes_no(question)
  if not is_tty() then return false end
  io.write(question .. " [y/N] ")
  local ans = io.read("*l")
  return ans == "y" or ans == "Y" or ans == "yes" or ans == "YES"
end

-- ---------- AGENTS.md directive (idempotent marker block) ----------

local TODO_AGENTS_BEGIN = "<!-- begin todo agent directive -->"
local TODO_AGENTS_END = "<!-- end todo agent directive -->"
local TODO_AGENTS_BLOCK = table.concat({
  TODO_AGENTS_BEGIN,
  "## todo CLI (repo tasks in ./todos/)",
  "- `todo list` / `todo ls --status=<pending|in-progress|done|canceled>` -- list tasks",
  "- `todo status ID` -- show full task markdown",
  "- `todo add TITLE \"DESC\" [\"DETAILS\"]` -- create task",
  "- `todo update ID <status>` -- change status",
  "- Do NOT use `todo edit` (needs interactive $EDITOR/TTY); prefer status/update.",
  TODO_AGENTS_END,
}, "\n") .. "\n"

-- action: "yes" forces add, "no" forces skip, nil prompts when TTY
local function ensure_agents_directive(action)
  local want = action == "yes"
  if action ~= "no" and not want then
    if not prompt_yes_no("Add todo directive to AGENTS.md?") then return end
    want = true
  end
  if not want then return end
  local path = "AGENTS.md"
  local existing = read_file(path) or ""
  if existing:find(TODO_AGENTS_BEGIN, 1, true) then
    print("AGENTS.md already has todo directive, skipping.")
    return
  end
  local sep = ""
  if existing ~= "" then
    if not existing:match("\n$") then sep = "\n" end
    sep = sep .. "\n"
  end
  write_file(path, existing .. sep .. TODO_AGENTS_BLOCK)
  print("Added todo directive to AGENTS.md")
end

-- ---------- embed (copy self into project + root symlink) ----------

local function self_path()
  local src = (arg and arg[0]) or "todo"
  if not src:find("/", 1, true) then
    local p = io.popen('command -v todo 2>/dev/null')
    local resolved = p and p:read("*l")
    if p then p:close() end
    if resolved and resolved ~= "" then src = resolved end
  end
  return src
end

local function is_symlink(path)
  local ok, _, code = os.execute(string.format('test -L "%s" 2>/dev/null', path))
  return ok == true or ok == 0
end

local function embed_self()
  ensure_dir("scripts")
  local dest = "scripts/todo"
  if read_file(dest) then
    print("scripts/todo already exists, skipping copy.")
  else
    local src = self_path()
    local ok, _, code = os.execute(string.format('cp "%s" "%s" && chmod +x "%s"', src, dest, dest))
    if not (ok == true or ok == 0) then
      print("Failed to copy " .. src .. " to " .. dest)
      return
    end
    print("Embedded todo at scripts/todo")
  end
  if read_file("todo") and not is_symlink("todo") then
    print("./todo already exists (not a symlink), skipping symlink.")
  else
    os.execute('ln -sf "scripts/todo" "todo"')
    print("Symlinked ./todo -> scripts/todo")
  end
end

-- ---------- index (todos/index.lua) ----------

local function load_index()
  local ok, data = pcall(dofile, INDEX_FILE)
  if ok and type(data) == "table" then
    return data
  end
  return { last_id = 0, tasks = {} }
end

local function save_index(index)
  local lines = {}
  table.insert(lines, "-- auto-generated by todo.lua; safe to hand-edit, but keep the shape.")
  table.insert(lines, "return {")
  table.insert(lines, ("  last_id = %d,"):format(index.last_id))
  table.insert(lines, "  tasks = {")
  for _, t in ipairs(index.tasks) do
    table.insert(lines, string.format(
      '    { id = "%s", title = "%s", status = "%s", created_at = "%s", last_modified = "%s", file = "%s" },',
      t.id, escape_lua_string(t.title), t.status, t.created_at, t.last_modified, t.file
    ))
  end
  table.insert(lines, "  },")
  table.insert(lines, "}")
  write_file(INDEX_FILE, table.concat(lines, "\n") .. "\n")
end

local function find_task(index, id)
  for _, t in ipairs(index.tasks) do
    if t.id == id then return t end
  end
  return nil
end

-- ---------- markdown rendering / parsing ----------

local function render_markdown(task, description, details)
  local parts = {
    "---",
    string.format('id: "%s"', task.id),
    string.format('title: "%s"', escape_lua_string(task.title)),
    string.format("status: %s", task.status),
    string.format("created_at: %s", task.created_at),
    string.format("last_modified: %s", task.last_modified),
    "---",
    "",
    string.format("# %s: %s", task.id, task.title),
    "",
    "## Description",
    description or "",
    "",
  }
  if details and details ~= "" then
    table.insert(parts, "## Details")
    table.insert(parts, details)
    table.insert(parts, "")
  end
  return table.concat(parts, "\n")
end

-- ---------- commands ----------

local function cmd_add(title, description, details)
  if not title or title == "" then
    print("Usage: todo add TITLE \"DESCRIPTION\" [\"DETAILS\"]")
    return
  end
  ensure_dir(TODO_DIR)
  local index = load_index()
  local id = pad_id(index.last_id + 1)
  local filename = string.format("%s-%s.md", id, slugify(title))
  local filepath = TODO_DIR .. "/" .. filename

  local now = iso_now()
  local task = {
    id = id,
    title = title,
    status = "pending",
    created_at = now,
    last_modified = now,
    file = filename,
  }

  write_file(filepath, render_markdown(task, description or "", details))

  index.last_id = index.last_id + 1
  table.insert(index.tasks, task)
  save_index(index)

  print(string.format("Added task %s: %s (%s)", id, title, filepath))
end

local function cmd_list(filter)
  local want = nil
  local a = filter
  if a == nil or a == "--all" then want = nil
  elseif a == "--done" then want = "done"
  elseif a == "--pending" then want = "pending"
  elseif a == "--canceled" or a == "--cancelled" then want = "canceled"
  elseif a == "--in-progress" or a == "--inprogress" then want = "in-progress"
  elseif a and a:match("^%-%-status=") then want = a:match("^%-%-status=(.+)$")
  else
    print("Unknown filter: " .. tostring(a) .. " (use --all or --status=pending|in-progress|done|canceled)")
    return
  end
  if want and not STATUSES[want] then
    print("Unknown status: " .. want .. " (use pending|in-progress|done|canceled)")
    return
  end

  local index = load_index()
  local want_status = want
  local shown = 0
  for _, t in ipairs(index.tasks) do
    if not want_status or t.status == want_status then
      print(string.format("[%s] %-7s %s  (%s)", t.id, t.status, t.title, t.created_at))
      shown = shown + 1
    end
  end
  if shown == 0 then
    print("No tasks" .. (want_status and (" with status: " .. want_status) or "") .. ".")
  end
end

local function cmd_status(id)
  if not id then
    print("Usage: todo status TASK_ID")
    return
  end
  local index = load_index()
  local task = find_task(index, id)
  if not task then
    print("No task with id " .. id)
    return
  end
  local content = read_file(TODO_DIR .. "/" .. task.file)
  if content then
    print(content)
  else
    print(string.format("[%s] %s — %s (file missing: %s)", task.id, task.status, task.title, task.file))
  end
end

local function cmd_update(id, new_status)
  if not id or not new_status then
    print("Usage: todo update TASK_ID pending|in-progress|done|canceled")
    return
  end
  if not STATUSES[new_status] then
    print("Status must be one of: pending, in-progress, done, canceled")
    return
  end
  local index = load_index()
  local task = find_task(index, id)
  if not task then
    print("No task with id " .. id)
    return
  end
  local filepath = TODO_DIR .. "/" .. task.file
  local now = iso_now()
  local ok_status = set_frontmatter_field(filepath, "status", new_status)
  local ok_mod = set_frontmatter_field(filepath, "last_modified", now)
  if not ok_status then
    print("Warning: could not update status line in " .. task.file)
  end
  if not ok_mod then
    print("Warning: could not update last_modified line in " .. task.file .. " (older files may lack this field)")
  end
  task.status = new_status
  task.last_modified = now
  save_index(index)
  print(string.format("Task %s -> %s", id, new_status))
end

local function cmd_edit(id)
  if not id then
    print("Usage: todo edit TASK_ID")
    print("Note: needs interactive $EDITOR/TTY; AI agents should use status/update instead.")
    return
  end
  local index = load_index()
  local task = find_task(index, id)
  if not task then
    print("No task with id " .. id)
    return
  end
  local editor = os.getenv("EDITOR")
  if not editor or editor == "" then
    print("Error: $EDITOR is not set (e.g. export EDITOR=nvim).")
    return
  end
  local filepath = TODO_DIR .. "/" .. task.file
  os.execute(string.format('%s "%s"', editor, filepath))
  -- resync index with any frontmatter edits made by hand
  local st = get_frontmatter_field(filepath, "status")
  if st and STATUSES[st] then task.status = st end
  local ti = get_frontmatter_field(filepath, "title")
  if ti and ti ~= "" then task.title = ti end
  task.last_modified = iso_now()
  set_frontmatter_field(filepath, "last_modified", task.last_modified)
  save_index(index)
  print(string.format("Edited task %s (%s)", id, filepath))
end

local function cmd_init()
  local embed, agents = false, nil
  for k = 2, #arg do
    local a = arg[k]
    if a == "--embed" then embed = true
    elseif a == "--agents" then agents = "yes"
    elseif a == "--no-agents" then agents = "no"
    else print("Unknown init flag: " .. a .. " (use --embed, --agents, --no-agents)") return end
  end
  ensure_dir(TODO_DIR)
  if read_file(INDEX_FILE) then
    print(INDEX_FILE .. " already exists, skipping.")
  else
    save_index({ last_id = 0, tasks = {} })
    print("Created " .. INDEX_FILE)
  end
  if embed then embed_self() end
  ensure_agents_directive(agents)
end

local function usage()
  print([[
todo — a markdown-backed todo CLI

  todo add TITLE "DESCRIPTION" ["DETAILS"]
  todo list|ls [--all|--done|--pending|--canceled|--in-progress|--status=STATUS]
  todo status TASK_ID
  todo update TASK_ID pending|in-progress|done|canceled
  todo edit TASK_ID            (opens $EDITOR; needs TTY, not for AI agents)
  todo init [--embed] [--agents|--no-agents]
]])
end

-- ---------- dispatch ----------

local command = arg[1]

if command == "add" then
  cmd_add(arg[2], arg[3], arg[4])
elseif command == "list" or command == "ls" then
  cmd_list(arg[2])
elseif command == "status" then
  cmd_status(arg[2])
elseif command == "update" then
  cmd_update(arg[2], arg[3])
elseif command == "edit" then
  cmd_edit(arg[2])
elseif command == "init" then
  cmd_init()
else
  usage()
end
